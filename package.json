{
  "name": "movie-server",
  "private": true,
  "version": "0.1.0",
  "description": "Emby-style media platform with Netflix-style subscriptions",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run start:dev -w @movie-server/api",
    "dev:web": "npm run dev -w @movie-server/web",
    "build": "npm run build -w @movie-server/shared && npm run build -w @movie-server/api && npm run build -w @movie-server/web",
    "postinstall": "npm run build -w @movie-server/shared",
    "build:api": "npm run build -w @movie-server/api",
    "build:web": "npm run build -w @movie-server/web",
    "start:api": "npm run start:prod -w @movie-server/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w @movie-server/api",
    "test:api:e2e": "npm run test:e2e -w @movie-server/api",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json}\" \"packages/**/*.{ts,js,json}\"",
    "license:generate": "node scripts/generate-license.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "multer": "2.3.0",
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    }
  },
  "allowScripts": {
    "ffmpeg-static@5.2.0": true
  }
}
