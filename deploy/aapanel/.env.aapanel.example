# =============================================================================
# AmarPin — aaPanel production environment
# Copy to project root as `.env` before: docker compose -f docker-compose.aapanel.yml up -d
# =============================================================================

NODE_ENV=production
PORT=4000

APP_NAME=AmarPin
# Public URLs (no trailing slash)
APP_URL=https://movies.amarpin.com
API_URL=https://movies.api.amarpin.com
API_PREFIX=api/v1

# Local Docker mongo (default) OR MongoDB Atlas mongodb+srv://...
MONGODB_URI=mongodb://mongo:27017/cinevault
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MUST change — long random string (32+ chars)
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=90
BCRYPT_ROUNDS=12

# HTTPS behind aaPanel Nginx (share cookies between web + API subdomains)
COOKIE_SECURE=true
COOKIE_DOMAIN=.amarpin.com
COOKIE_SAME_SITE=lax

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=900000
AUTH_THROTTLE_LIMIT=8
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Optional SMTP (leave empty to log mail in API container)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AmarPin <noreply@amarpin.com>"

# First Super Admin (only created if no admin exists)
BOOTSTRAP_SUPERADMIN_EMAIL=admin@amarpin.com
BOOTSTRAP_SUPERADMIN_PASSWORD=CHANGE_ME_Strong_Password_123!

MAX_PROFILES_PER_ACCOUNT=5
AVATAR_MAX_BYTES=2097152

SUBSCRIPTION_REQUIRE_PAYMENT=true
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_DEFAULT_CURRENCY=BDT

# Payments — public HTTPS rejects PAYMENT_PROVIDER=fake (API will not start).
# Use Stripe test/live keys for production domains.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_webhook_secret_16plus

# Paths inside the API container (bind-mounted in docker-compose.aapanel.yml)
ARTWORK_UPLOAD_DIR=/app/storage/uploads/artwork
SMB_MOUNT_ROOT=/data/smb-mounts
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MEDIA_PROBE=auto

TMDB_API_KEY=
LIBRARY_AUTO_IMPORT=true
LIBRARY_AUTO_PUBLISH=true

# Host directories mounted into the API container (absolute paths on the VPS)
CINEVAULT_MEDIA_HOST=/data/movies.amarpin.com/media
CINEVAULT_SMB_HOST=/data/movies.amarpin.com/smb-mounts

# Web origin allowed to call the API (comma-separated)
CORS_ORIGINS=https://movies.amarpin.com

# License — use a dedicated secret (do not reuse a weak JWT). Generate keys on your vendor machine:
#   LICENSE_MASTER_SECRET=... node scripts/generate-license.mjs --days 365 --edition pro
LICENSE_MASTER_SECRET=CHANGE_ME_license_hmac_secret_32chars_min
LICENSE_KEY=
LICENSE_TRIAL_DAYS=30
LICENSE_DISABLED=false

NEXT_PUBLIC_APP_NAME=AmarPin
# Baked into the web Docker image at build time
NEXT_PUBLIC_API_URL=https://movies.api.amarpin.com/api/v1
