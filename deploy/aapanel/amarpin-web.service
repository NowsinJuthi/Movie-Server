[Unit]
Description=AmarPin Web
After=network.target amarpin-api.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/movies.amarpin.com/apps/web/.next/standalone/apps/web
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# Direct node (no npm start:web needed on VPS)
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
