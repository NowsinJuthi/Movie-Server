NODE_ENV=development
PORT=4001

APP_NAME=CineVault
APP_URL=http://localhost:3001
API_URL=http://localhost:4001
API_PREFIX=api/v1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/cinevault

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth / JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret-32+
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# Cookies — set COOKIE_SECURE=true behind HTTPS in production
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=900000
AUTH_THROTTLE_LIMIT=8
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Mail (leave SMTP empty to configure in Admin → System → Settings, or log to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CineVault <noreply@localhost>"

# First Super Admin (created only if none exists). Change this password before any public deploy.
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMe_Admin_123!

MAX_PROFILES_PER_ACCOUNT=5
AVATAR_MAX_BYTES=2097152

# Subscriptions / billing
SUBSCRIPTION_REQUIRE_PAYMENT=true
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_DEFAULT_CURRENCY=USD

# Payments (Stripe Checkout + webhooks). Use PAYMENT_PROVIDER=fake for local UI without Stripe.
# Public production origins reject fake providers and the example webhook secret.
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYMENT_WEBHOOK_SECRET=whsec_test_cinevault_webhook_secret

# Media libraries (absolute directories). Leave empty to configure in Admin → Libraries.
MEDIA_MOVIES_DIR=
MEDIA_TV_DIR=
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MEDIA_PROBE=auto

# Optional TMDB key so library scans can pull posters/metadata like Emby.
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
LIBRARY_AUTO_IMPORT=true
LIBRARY_AUTO_PUBLISH=true

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3001

# License (30-day trial, then require a signed key). Prefer a dedicated signing secret.
# Generate keys: node scripts/generate-license.mjs --days 365 --edition pro
LICENSE_MASTER_SECRET=
# Optional: auto-activate this key on API boot
LICENSE_KEY=
LICENSE_TRIAL_DAYS=30
# LICENSE_SEAL_DIR=
# LICENSE_DISABLED=false

# Web
NEXT_PUBLIC_APP_NAME=CineVault
NEXT_PUBLIC_API_URL=/api/v1

